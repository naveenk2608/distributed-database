# Copy to terraform.tfvars (which git ignores) and fill in. Every other
# variable has a default; see variables.tf.
allowed_cidr        = "203.0.113.7/32"     # your public address, as a /32
ssh_public_key_file = "~/.ssh/dkv-aws.pub" # ssh-keygen -t ed25519 -f ~/.ssh/dkv-aws

# region                = "ap-south-1"
# availability_zones    = []               # empty: the first three that offer the instance types
# node_count            = 3
# node_instance_type    = "c7i-flex.large" # free-tier eligible; free_tier_only refuses others
# loadgen_instance_type = "c7i-flex.large"
# volume_size_gb        = 8
